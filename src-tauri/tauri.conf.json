{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pokemon TCG Collector Sim",
  "version": "1.0.0",
  "identifier": "com.pokesim.collector",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Pokémon TCG Collector & Card Shop Simulator", "width": 1366, "height": 860, "minWidth": 1100, "minHeight": 700, "resizable": true, "center": true }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$APPDATA/music/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Pokemon TCG collecting and reselling simulator",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["English"] } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
